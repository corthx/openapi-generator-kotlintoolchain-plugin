{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    ":dependencyDashboard",
  ],

  dependencyDashboard: true,
  dependencyDashboardTitle: "Renovate Dependency Dashboard",

  // Title template must satisfy the project's mr-title-lint regex:
  // Rendered shape: "chore(deps): Update <dep> to <ver> #52".
  // The suffix is hardcoded to #52 (the Renovate "Dependency Dashboard"
  // issue) because Renovate exposes no template field for the dashboard
  // issue's IID. If the dashboard issue is ever recreated and assigned
  // a new IID, update this value accordingly.
  commitMessagePrefix: "chore({{#if isMajor}}deps-major{{else}}deps{{/if}}):",
  commitMessageAction: "Update",
  commitMessageTopic: "{{depName}}",
  commitMessageExtra: "to {{newVersion}}",
  commitMessageSuffix: "#52",

  commitBodyTable: true,

  branchPrefix: "renovate/",
  labels: ["dependencies"],
  rebaseWhen: "behind-base-branch",
  prConcurrentLimit: 10,
  // Disable hourly rate limiting; prConcurrentLimit already caps how
  // many MRs can be open at once, so the default prHourlyLimit: 2 just
  // queues legitimate updates under "Rate-Limited" on the dashboard.
  prHourlyLimit: 0,

  rangeStrategy: "pin",

  // Renovate ships no native manager for GitLab CI components, so track
  // them via a regex manager backed by the gitlab-tags datasource.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [
        "(^|/)\\.gitlab/ci/.*\\.ya?ml$",
        "(^|/)\\.gitlab-ci\\.ya?ml$",
      ],
      matchStrings: [
        // `$` excluded from the host class: variable hosts are skipped, not
        // captured into the unresolvable `https://$CI_SERVER_FQDN`.
        "component:\\s+(?<registryUrl>[^/\\s$]+)/(?<depName>[^@\\s]+)@(?<currentValue>[^\\s]+)",
      ],
      datasourceTemplate: "gitlab-tags",
      registryUrlTemplate: "https://{{registryUrl}}",
      versioningTemplate: "semver",
    },
    // Values pinned next to a `# renovate:` comment, for versions written
    // twice (the OpenTofu component's inputs mirror its include ref and the
    // mise.toml opentofu pin).
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.gitlab/ci/.+\\.gitlab-ci\\.yml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: packageName=(?<packageName>\\S+))?(?: registryUrl=(?<registryUrl>\\S+))?\\s+\\S+:\\s*\"?(?<currentValue>[^\"\\s]+)\"?",
      ],
      extractVersionTemplate: "^v?(?<version>.+)$",
    },
  ],

  // Lets the gitlabci-include manager resolve the OpenTofu component's
  // `$CI_SERVER_FQDN/...` include ref.
  gitlabci: {
    registryAliases: {
      $CI_SERVER_FQDN: "gitlab.com",
    },
  },

  // Refreshes the units' .terraform.lock.hcl files.
  lockFileMaintenance: {
    enabled: true,
  },

  packageRules: [
    {
      matchManagers: ["mise"],
      groupName: "mise tools",
      commitMessageTopic: "mise tools",
    },
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
      commitMessageTopic: "github actions",
    },
    {
      matchManagers: ["mise", "gradle", "gitlabci", "gitlabci-include"],
      matchUpdateTypes: ["patch", "minor"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    // openapi-generator is the core library this plugin wraps. Patches
    // automerge (covered by the rule above); keep minor manual since
    // behavior may change.
    {
      matchManagers: ["gradle"],
      matchPackageNames: ["org.openapitools:openapi-generator"],
      matchUpdateTypes: ["minor"],
      automerge: false,
    },
    {
      matchManagers: ["gitlabci", "gitlabci-include"],
      groupName: "CI Images",
    },
    // Modules provision the tokens CI authenticates with; a bad bump locks
    // the pipeline out of the project.
    {
      matchManagers: ["terraform"],
      matchDepTypes: ["module"],
      automerge: false,
    },
    // OpenTofu (mise.toml, mirrored in the component's opentofu_version input)
    // and the OpenTofu CI component (include ref, mirrored in its version
    // input) move together, since a component release is what ships images for
    // new OpenTofu versions. Changing tofu.gitlab-ci.yml alone plans no unit,
    // so the tofu:plan label makes the MR plan them all. Must stay after the
    // mise rules: packageRules merge in order.
    {
      matchDepNames: ["opentofu", "components/opentofu"],
      groupName: "opentofu",
      commitMessageTopic: "opentofu",
      addLabels: ["tofu:plan"],
      automerge: false,
    },
    // Majors always manual, regardless of manager.
    {
      matchUpdateTypes: ["major"],
      automerge: false,
      commitMessagePrefix: "chore(deps-major):",
    },
  ],

  vulnerabilityAlerts: {
    enabled: true,
    schedule: ["at any time"],
    labels: ["security", "dependencies"],
    commitMessagePrefix: "security(deps):",
  },
}
